{
  "name": "telegram-channel-bot",
  "version": "1.0.0",
  "description": "Telegram 频道资料管理机器人：关键词上传/搜索/发布、网页相册、金库备份换 Token，支持 Docker 部署",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "install-linux": "chmod +x install.sh && ./install.sh",
    "start-linux": "chmod +x start.sh && ./start.sh",
    "stop-linux": "chmod +x stop.sh && ./stop.sh",
    "clear-db": "node scripts/clear-database.js",
    "clear-db-win": "powershell -ExecutionPolicy Bypass -File scripts/clear-database.ps1",
    "vault:sync": "ts-node scripts/vault-sync.ts",
    "vault:claim": "ts-node scripts/vault-claim.ts",
    "vault:status": "ts-node scripts/vault-status.ts",
    "vault:probe": "ts-node scripts/vault-probe.ts",
    "vault:reset-coords": "ts-node scripts/vault-reset-coords.ts",
    "android:worker": "ts-node scripts/android-worker.ts",
    "android:probe": "ts-node scripts/android-worker.ts --probe",
    "android:notesync": "ts-node scripts/android-worker.ts --notesync",
    "android:ui": "node scripts/ui-inspect.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "telegram",
    "bot",
    "channel",
    "media",
    "upload",
    "search"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "input": "^1.0.1",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "sql.js": "^1.13.0",
    "sqlite3": "^5.1.6",
    "telegraf": "^4.15.6",
    "telegram": "^2.26.22",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/sqlite3": "^3.1.8",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
