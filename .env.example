# ========== 复制为 .env 后填写真实值（勿把 .env 提交到 Git）==========

BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=your_telegram_numeric_id
CHANNEL_IDS=-100xxxxxxxxxx
DATABASE_PATH=./data/bot.db
NODE_ENV=development
LOG_LEVEL=info

# 备份金库（换 Token / 迁 bot 必填）
PERSISTENT_CHANNEL_ID=-100yyyyyyyyyy
# PERSISTENT_GROUP_ID=-100zzzzzzzzzz
# ADMIN_PERSISTENT_CHANNEL_MAP=

# 新 bot 认领（npm run vault:claim）
# NEW_BOT_TOKEN=
# CLAIM_TO_CHAT_ID=

# 流程提示：
# 1. npm run vault:status
# 2. npm run vault:sync
# 3. npm run vault:claim
# 4. 将 BOT_TOKEN 换成新 Token 后重启

# 可选
# ADMIN_IDS=
# ADMIN_CHANNEL_MAP=
# TELEGRAM_API_ROOT=https://api.telegram.org
# DOMAIN=http://localhost:3000

# Android 自动发送执行端（Bot 在 VPS、手机在本地时必填）
# 请生成一个随机长字符串；Worker 的 ANDROID_WORKER_TOKEN 必须相同。
# ANDROID_WORKER_TOKEN=replace_with_a_long_random_secret
# ANDROID_TASK_LEASE_MS=300000

# 节流保护：两次发送之间的随机间隔，以及每日发送上限（0 表示不限）。
# 连续私信是第三方 App 风控最敏感的行为，不建议关掉。
# ANDROID_SEND_MIN_INTERVAL_MS=20000
# ANDROID_SEND_MAX_INTERVAL_MS=45000
# ANDROID_DAILY_SEND_LIMIT=30

# 上传资料后自动把素材同步成 App 里的一条笔记。
# 配了 ANDROID_WORKER_TOKEN 就默认开启；只有想单独关掉时才需要显式设为 false。
# 同步只操作自己的账号，不占用上面的每日私信配额。
# ANDROID_NOTE_SYNC=false
