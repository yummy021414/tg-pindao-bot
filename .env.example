# ========== 复制为 .env 后填写真实值（勿把 .env 提交到 Git）==========

BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=your_telegram_numeric_id
CHANNEL_IDS=-100xxxxxxxxxx
DATABASE_PATH=./data/bot.db
NODE_ENV=development
LOG_LEVEL=info

# 备份金库（换 Token / 迁 bot 必填）
PERSISTENT_CHANNEL_ID=-100yyyyyyyyyy
# PERSISTENT_GROUP_ID=-100zzzzzzzzzz
# ADMIN_PERSISTENT_CHANNEL_MAP=

# 新 bot 认领（npm run vault:claim）
# NEW_BOT_TOKEN=
# CLAIM_TO_CHAT_ID=

# 流程提示：
# 1. npm run vault:status
# 2. npm run vault:sync
# 3. npm run vault:claim
# 4. 将 BOT_TOKEN 换成新 Token 后重启

# 可选
# ADMIN_IDS=
# ADMIN_CHANNEL_MAP=
# TELEGRAM_API_ROOT=https://api.telegram.org
# DOMAIN=http://localhost:3000
